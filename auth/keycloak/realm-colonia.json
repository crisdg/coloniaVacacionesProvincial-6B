{
  "realm": "colonia",
  "displayName": "Colonia de Vacaciones",
  "enabled": true,
  "sslRequired": "none",
  "internationalizationEnabled": true,
  "supportedLocales": [ "es", "en" ],
  "defaultLocale": "es",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "tutor", "description": "Consulta turnos, solicita inscripciones y consulta las propias" },
      { "name": "administrador", "description": "Gestiona turnos y consulta, corrige y cancela inscripciones" }
    ]
  },
  "users": [
    {
      "username": "ana",
      "firstName": "Ana",
      "lastName": "Administradora",
      "email": "ana@colonia.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "ana123", "temporary": false } ],
      "realmRoles": [ "administrador" ]
    },
    {
      "username": "beto",
      "firstName": "Beto",
      "lastName": "Tutor",
      "email": "beto@colonia.local",
      "emailVerified": true,
      "enabled": true,
      "credentials": [ { "type": "password", "value": "beto123", "temporary": false } ],
      "realmRoles": [ "tutor" ]
    }
  ],
  "clients": [
    {
      "clientId": "frontend",
      "name": "Frontend (cliente público)",
      "description": "Corre en el navegador: no puede guardar un secreto. Usa Authorization Code + PKCE S256.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [ "http://localhost:3001/" ],
      "webOrigins": [ "http://localhost:3001" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/"
      },
      "protocolMappers": [
        {
          "name": "audiencia-api-colonia",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api-colonia",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "swagger-ui",
      "name": "Swagger UI (cliente público)",
      "description": "Corre en el navegador: no puede guardar un secreto. Usa Authorization Code + PKCE S256.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [ "http://localhost:8080/oauth2-redirect.html" ],
      "webOrigins": [ "http://localhost:8080" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/oauth2-redirect.html"
      },
      "protocolMappers": [
        {
          "name": "audiencia-api-colonia",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "api-colonia",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
